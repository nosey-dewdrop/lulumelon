# Copy to .env and fill in the one you have. Nothing here is read unless the
# keychain has no key for that provider, and the file is created 0600 when
# `lulu setup` writes it for you.
#
# `lulu doctor` says which of these it found, in the order it looked, and
# `lulu setup` puts a key in the OS keychain instead, which is where it should
# live on a machine you use for anything else.

# Claude on the Messages API. This is the engine both paid commands default to.
ANTHROPIC_API_KEY=

# Perplexity Sonar. Only two engines exist in this build and this is the other
# one; `lulu collect --provider perplexity` reaches it.
PERPLEXITY_API_KEY=

# The same two under a prefixed name, read first, for a machine that already
# has a key for something else in the plain one.
# LULU_ANTHROPIC_API_KEY=
# LULU_PERPLEXITY_API_KEY=

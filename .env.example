LLM_PROVIDER=fake

# only read when LLM_PROVIDER is anthropic or openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# per-role models. the answer role impersonates a real user question;
# the sentiment role only classifies, so it gets the cheap model.
LLM_MODEL_ANSWER=
LLM_MODEL_SENTIMENT=

# stub failure switches, for exercising degraded rounds
LLM_FAKE_FAIL_EVERY_NTH_DRAW=
LLM_FAKE_FAIL_ROLE=

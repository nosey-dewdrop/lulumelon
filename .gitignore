# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# local run store
/.data/

# secrets never enter the repo
.env*
!.env.example

# local intel, never published
/reports/

# python build and cache artefacts
__pycache__/
*.pyc
.venv/
*.egg-info/
/build/
/dist/

# a collected round is the customer's own data and the default write path is
# ./ledger, so it stays out of the package repo rather than relying on nobody
# running `git add -A` in a directory they just measured in. no leading slash,
# because a round collected from a subdirectory is the same customer's data and
# the rule that was pinned to the root did not cover it
ledger/

# internal strategy and session state. a public product repo is not where a
# competitor teardown or a transcript of what was said in a session belongs,
# and .rabadon grows on every run, so it leaks more with each commit.
/YOL-HARITASI.txt
/HANDOFF.txt
.rabadon/

# next static export
/out/
/.next/
